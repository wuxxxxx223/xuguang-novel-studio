# 复制为 .env.production；该文件已被 Git 忽略。
COMPOSE_PROJECT_NAME=xuguang-novel-studio

# 宿主机持久化目录，必须使用绝对路径。两个目录会被备份为同一恢复点。
NOVEL_STUDIO_HOST_DATA_DIR=/srv/xuguang-novel-studio/data
NOVEL_STUDIO_HOST_LIBRARY_ROOT=/srv/xuguang-novel-studio/library

# 默认只发布到宿主机回环地址。不要改成 0.0.0.0，除非前方已有 TLS 和身份认证。
NOVEL_STUDIO_PUBLIC_PORT=8790

# 发布时应改成明确的版本或 Git SHA；不要把 latest 当作回滚依据。
NOVEL_STUDIO_IMAGE=xuguang-novel-studio:0.1.0
NOVEL_STUDIO_VERSION=0.1.0

# 若反向代理与应用位于同一可信边界，可设为 loopback 或明确的代理跳数。
NOVEL_STUDIO_TRUST_PROXY=false
NOVEL_STUDIO_TRUSTED_ORIGINS=

# 1-120 秒。
NOVEL_STUDIO_SHUTDOWN_TIMEOUT_MS=30000
