limit_req_zone $binary_remote_addr zone=novel_studio_api:10m rate=10r/s;

upstream novel_studio {
    server 127.0.0.1:8790;
    keepalive 16;
}
server {
    listen 80;
    server_name novel.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name novel.example.com;

    ssl_certificate /etc/letsencrypt/live/novel.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/novel.example.com/privkey.pem;

    auth_basic "Novel Studio";
    auth_basic_user_file /etc/nginx/novel-studio.htpasswd;

    client_max_body_size 2m;

    location / {
        limit_req zone=novel_studio_api burst=30 nodelay;
        proxy_pass http://novel_studio;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Request-Start "t=${msec}";
        proxy_read_timeout 650s;
        proxy_send_timeout 650s;
    }
}
